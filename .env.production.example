# Production environment template for irish-rail-nabber.
# Copy this to your deployment secret store or an ignored local env file.
# Do not commit real values.

# Identity
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# Public app routing
APP_URL=https://traein.semyon.ie
CORS_ORIGINS=https://traein.semyon.ie

# Database
POSTGRES_USER=irish_data
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=ireland_public
DATABASE_URL=postgresql://irish_data:replace_me@db:5432/ireland_public

# NTA bus data
NTA_API_KEY=
NTA_GTFS_URL=https://www.transportforireland.ie/transitData/Data/GTFS_Realtime.zip
NTA_TRIP_UPDATES_URL=https://api.nationaltransport.ie/gtfsr/v2/gtfsr?format=json
NTA_VEHICLES_URL=https://api.nationaltransport.ie/gtfsr/v2/Vehicles?format=json
# Deprecated fallback for NTA_TRIP_UPDATES_URL:
# NTA_GTFSR_URL=https://api.nationaltransport.ie/gtfsr/v2/gtfsr?format=json
BUS_STATIC_REFRESH_SECONDS=86400
BUS_REALTIME_INTERVAL_SECONDS=60
BUS_REALTIME_RETENTION_DAYS=7

# API rate limits
API_RATE_LIMIT_FREE_TIER_LIMIT=25000
API_RATE_LIMIT_COFFEE_TIER_LIMIT=100000
API_RATE_LIMIT_UNLIMITED_ROLES=pro,admin
API_RATE_LIMIT_IP_SALT=replace_me

# Chatbot LLM / OpenAI-compatible provider
LLM_API_URL=https://api.moonshot.ai/v1
LLM_API_KEY=replace_me
LLM_MODEL=kimi-k2.5
LLM_THINKING=off
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1200
CHAT_MAX_TOOL_ITERATIONS=3
CHAT_MAX_TOOL_CALLS_PER_TURN=3
CHAT_TOOL_RESULT_MAX_CHARS=3500

# Alternative OpenAI-compatible names, if reused by deployment tooling
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL=
CHAT_REQUEST_TIMEOUT_SECONDS=45
CHAT_MAX_TOKENS=1200

# Polar merchant-of-record billing
POLAR_CHECKOUT_ENABLED=false
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_WEBHOOK_SECRET=whsec_replace_me
POLAR_ORGANIZATION_ID=replace_me
POLAR_COFFEE_PRODUCT_ID=replace_me
POLAR_PRO_PRODUCT_ID=replace_me
POLAR_ENVIRONMENT=production

# Edge tunnel
CLOUDFLARE_TUNNEL_TOKEN=replace_me
